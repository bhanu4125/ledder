# Copy to .env and replace every password/key placeholder before starting.
DATABASE_OWNER_PASSWORD=replace-with-a-unique-owner-password
DATABASE_PASSWORD=replace-with-a-unique-runtime-password
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes-long
FRONTEND_ORIGIN=http://localhost
FRONTEND_PORT=80
SECURE_COOKIES=false
AUTHORISATION_THRESHOLD=10000.00
